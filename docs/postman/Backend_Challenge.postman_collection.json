        {
          "name": "Login - Happy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('Envelope has token and user', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(0);",
                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.user.id).to.eql(pm.environment.get('user_id'));",
                  "    pm.expect(json.data.user.name).to.eql(pm.environment.get('register_name'));",
                  "    pm.environment.set('access_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
