{
  "info": {
    "_postman_id": "c3e8a1d4-7b2f-4e91-9c55-4a6f8d12b0e1",
    "name": "Backend Challenge",
    "description": "User Management APIs for 7Solutions backend challenge.\n\nAuth:\n- `/health` and `/auth/*` do not require JWT\n- `/users/*` requires `Authorization: Bearer {{access_token}}`\n\nHappy path order: Health → Register → Login.\n\nSee docs/postman/README.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health - OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('Body has status ok', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "No JWT. Returns `{ status: \"ok\" }`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Happy",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const REGISTER_NAME = 'Alice';",
                  "const REGISTER_EMAIL = 'alice_' + Date.now() + '@example.com';",
                  "const REGISTER_PASSWORD = 'secret123';",
                  "",
                  "pm.environment.set('register_name', REGISTER_NAME);",
                  "pm.environment.set('register_email', REGISTER_EMAIL);",
                  "pm.environment.set('register_password', REGISTER_PASSWORD);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "pm.test('Envelope code is 0', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(0);",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.name).to.eql(pm.environment.get('register_name'));",
                  "    pm.expect(json.data.email).to.eql(pm.environment.get('register_email'));",
                  "    pm.expect(json.data).to.have.property('createdAt');",
                  "    pm.environment.set('user_id', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{register_name}}\",\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Happy path. Pre-request สุ่ม email เพื่อไม่ชน unique index"
          },
          "response": []
        },
